{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-fullwidth-punct.py",
            "statusMessage": "Checking for full-width punctuation..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/confirm-delete.py",
            "statusMessage": "Checking for file deletion..."
          }
        ]
      }
    ]
  }
}
